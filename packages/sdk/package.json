{
  "name": "@weart/sdk",
  "version": "0.1.0",
  "description": "First-party analytics SDK for weartstudio.io",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./replay": { "types": "./dist/replay.d.ts", "import": "./dist/replay.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "size": "node scripts/build.mjs --size",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rrweb/record": "2.1.1"
  },
  "devDependencies": {
    "@weart/shared": "workspace:*",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
