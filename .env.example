# ---------- core infrastructure ----------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=weart
CLICKHOUSE_PASSWORD=weart
CLICKHOUSE_DB=weart
DATABASE_URL=postgresql://weart:weart@localhost:5432/weart
REDIS_URL=redis://localhost:6379

# S3-compatible storage (replays, page snapshots). Local: SeaweedFS from docker-compose.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=weart
S3_SECRET_KEY=weartsecret
S3_BUCKET=weart-blobs
S3_FORCE_PATH_STYLE=true

# ---------- ingest ----------
INGEST_PORT=4318
# Comma-separated origins allowed to send events (CORS). Use * only in dev.
INGEST_ALLOWED_ORIGINS=https://weartstudio.io,https://www.weartstudio.io,http://localhost:3000,http://localhost:5173
# Domain for the server-set visitor cookie (survives Safari ITP). Leave empty in dev.
INGEST_COOKIE_DOMAIN=
# Optional DB-IP / MaxMind City mmdb for geo lookup. Without it, geo comes from CDN headers (CF-IPCountry) or stays empty.
GEOIP_DB_PATH=./.data/dbip-city-lite.mmdb
# Trust X-Forwarded-For from the reverse proxy / CDN in front of ingest.
TRUST_PROXY=true
# Project site IDs accepted by ingest (comma-separated). Mapped to project_id.
INGEST_SITE_IDS=weartstudio

# ---------- dashboard ----------
DASHBOARD_URL=http://localhost:3000
# 32+ random bytes, used to sign share links and encrypt integration credentials
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ---------- conversion forwarding (worker) ----------
# All destinations run in dry-run (log only) until credentials are set AND enabled in Settings.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
TIKTOK_PIXEL_CODE=
TIKTOK_EVENTS_ACCESS_TOKEN=

# ---------- later milestones ----------
STRIPE_WEBHOOK_SECRET=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
SMTP_URL=
