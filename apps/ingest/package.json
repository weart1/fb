    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "lru-cache": "^11.0.2",
    "maxmind": "^4.3.22",
    "ua-parser-js": "^1.0.39",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ua-parser-js": "^0.7.39",
    "tsx": "^4.19.2",
