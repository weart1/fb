<clickhouse>
  <!-- async inserts absorb ad-traffic bursts: many small inserts are merged server-side -->
  <profiles>
    <default>
      <async_insert>1</async_insert>
      <wait_for_async_insert>1</wait_for_async_insert>
      <async_insert_busy_timeout_ms>1000</async_insert_busy_timeout_ms>
      <date_time_input_format>best_effort</date_time_input_format>
    </default>
  </profiles>
</clickhouse>
